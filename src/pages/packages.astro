---
import AppLayout from "../layouts/AppLayout.astro";
import { catalog } from "../lib/forge-data";

export const prerender = false;
const knownTools = catalog.filter((entry) => entry.enabled);
---

<AppLayout title="forge - Packages" description="Browse and download built packages from GitHub Releases.">
  <section class="hero">
    <section class="panel">
      <p class="kicker">Packages</p>
      <h1>Download builds.</h1>
      <p>Browse all releases or filter by tool. Every build produces a downloadable release.</p>
    </section>
    <aside class="panel stats">
      <div class="stat">
        <strong>{knownTools.length}</strong>
        <span class="muted">tools in catalog</span>
      </div>
      <div class="stat">
        <strong id="release-count">-</strong>
        <span class="muted">releases loaded</span>
      </div>
    </aside>
  </section>

  <section class="panel">
    <div class="toolbar">
      <div class="toolbar-left" style="display: flex; align-items: center; gap: 0.75rem; flex: 1;">
        <div class="field" style="flex: 1; margin: 0;">
          <input id="packages-search" placeholder="Search by tool name or repo..." style="min-width: 200px;" />
        </div>
        <button id="load-all-btn" type="button" class="secondary" style="flex-shrink: 0;">Browse all</button>
      </div>
    </div>
    <div id="pill-container" class="pill-list" style="margin-bottom: 1rem;">
      {knownTools.map((tool) => (
        <button class="pill" type="button" data-result-repo={tool.repo_url}>{tool.id}</button>
      ))}
    </div>
    <div id="results-list" class="empty">Load releases to see available packages.</div>
  </section>

  <script>
    interface ReleaseAsset {
      name: string;
      size: number;
    }

    interface Release {
      tag: string;
      name: string | null;
      published_at: string;
      assets: ReleaseAsset[];
    }

    let allReleases: Release[] = [];
    let activeFilter: string = "";

    const pillContainer = document.getElementById("pill-container");
    const resultsList = document.getElementById("results-list") as HTMLElement;
    const searchInput = document.getElementById("packages-search") as HTMLInputElement;
    const releaseCount = document.getElementById("release-count") as HTMLElement;

    function extractToolId(tag: string): string {
      const match = tag.match(/^tool\/([^/]+)/);
      return match ? match[1] : "";
    }

    function renderReleases(releases: Release[], searchTerm: string = "") {
      let filtered = releases;

      if (activeFilter) {
        filtered = filtered.filter((r) => {
          const toolId = extractToolId(r.tag);
          const entry = document.querySelector(`[data-result-repo]`);
          const pills = pillContainer?.querySelectorAll("[data-result-repo]");
          if (pills) {
            for (const pill of pills) {
              const repo = (pill as HTMLElement).dataset.resultRepo;
              if (repo === activeFilter) {
                const pillToolId = pill.textContent;
                return toolId === pillToolId;
              }
            }
          }
          return true;
        });
      }

      if (searchTerm) {
        const q = searchTerm.toLowerCase();
        filtered = filtered.filter((r) => {
          const toolId = extractToolId(r.tag);
          return toolId.includes(q) || r.tag.toLowerCase().includes(q) || (r.name && r.name.toLowerCase().includes(q));
        });
      }

      releaseCount.textContent = String(filtered.length);

      if (!filtered.length) {
        resultsList.innerHTML = `<div class="empty">No releases match your criteria.</div>`;
        return;
      }

      resultsList.innerHTML = filtered
        .map((release) => {
          const toolId = extractToolId(release.tag);
          return `
            <article class="result-card">
              <div class="split">
                <div>
                  <strong>${release.name ?? release.tag}</strong>
                  <div class="muted" style="font-size: 0.85rem; margin-top: 0.25rem;">${toolId}</div>
                </div>
                <span class="status success">${release.assets.length} assets</span>
              </div>
              <div class="pill-list" style="margin-top: 0.75rem;">
                ${release.assets
                  .map((asset) => {
                    const sizeInBytes = asset.size;
                    let sizeDisplay: string;
                    if (sizeInBytes < 1024 * 1024) {
                      sizeDisplay = `${(sizeInBytes / 1024).toFixed(1)} KB`;
                    } else {
                      sizeDisplay = `${(sizeInBytes / 1024 / 1024).toFixed(1)} MB`;
                    }
                    return `
                      <a class="button secondary asset-button" href="/api/releases/asset?tag=${encodeURIComponent(release.tag)}&name=${encodeURIComponent(asset.name)}">
                        <span class="asset-name">${asset.name}</span>
                        <span class="asset-size">${sizeDisplay}</span>
                      </a>
                    `;
                  })
                  .join("")}
              </div>
            </article>
          `;
        })
        .join("");
    }

    async function loadResults(repoUrl = "") {
      resultsList.innerHTML = "<div class='empty'>Loading…</div>";
      const query = repoUrl ? `?repo_url=${encodeURIComponent(repoUrl)}` : "";
      const response = await fetch(`/api/releases${query}`);

      if (!response.ok) {
        resultsList.innerHTML = "<div class='empty'>Unable to load packages.</div>";
        return;
      }

      const data = await response.json();

      if (!data.releases?.length) {
        releaseCount.textContent = "0";
        if (repoUrl) {
          resultsList.innerHTML = `
            <div class='empty'>
              <p>No packages found for <strong>${repoUrl}</strong>.</p>
              <p style="margin-top: 0.5rem;">Want to build it? <a href="/build?repo=${encodeURIComponent(repoUrl)}" class="button secondary" style="margin-top: 0.5rem; display: inline-flex;">Build it</a></p>
            </div>
          `;
        } else {
          resultsList.innerHTML = "<div class='empty'>No packages found yet. Build something!</div>";
        }
        return;
      }

      allReleases = data.releases;
      renderReleases(allReleases, searchInput.value);
    }

    function setActivePill(repoUrl: string) {
      pillContainer?.querySelectorAll(".pill").forEach((p) => p.classList.remove("active"));
      if (repoUrl) {
        pillContainer?.querySelectorAll("[data-result-repo]").forEach((p) => {
          if ((p as HTMLElement).dataset.resultRepo === repoUrl) {
            p.classList.add("active");
          }
        });
      }
    }

    document.querySelectorAll("[data-result-repo]").forEach((button) => {
      button.addEventListener("click", () => {
        const btn = button as HTMLButtonElement;
        const repo = btn.dataset.resultRepo ?? "";
        activeFilter = activeFilter === repo ? "" : repo;
        setActivePill(activeFilter);
        renderReleases(allReleases, searchInput.value);
      });
    });

    document.getElementById("load-all-btn")?.addEventListener("click", () => {
      activeFilter = "";
      setActivePill("");
      searchInput.value = "";
      loadResults("");
    });

    searchInput?.addEventListener("input", () => {
      renderReleases(allReleases, searchInput.value);
    });

    loadResults("");
  </script>
</AppLayout>

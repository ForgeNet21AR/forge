---
import AppLayout from "../../layouts/AppLayout.astro";

export const prerender = false;
const { id } = Astro.params;
---

<AppLayout title={`forge - Run #${id}`} description={`Track build run #${id} status and progress.`}>
  <section class="hero">
    <section class="panel">
      <p class="kicker">Run</p>
      <h1>Build status.</h1>
      <p>Build progress and job details.</p>
      <div class="inline-actions">
        <a class="button secondary" href="/runs">Back to runs</a>
        <a class="button ghost" href="/packages">Browse packages</a>
      </div>
    </section>
    <aside class="panel">
      <div class="stat">
        <strong>Run #{id}</strong>
        <span class="muted" id="auto-refresh-note">Auto-refreshes while the run is active.</span>
      </div>
    </aside>
  </section>

  <section class="panel">
    <div class="toolbar">
      <h2 class="section-title">Status</h2>
    </div>
    <div id="run-status" class="empty">Loading run data…</div>
  </section>

  <script define:vars={{ id }}>
    function statusClass(status, conclusion) {
      if (conclusion === "failure") return "status fail";
      if (conclusion === "success") return "status success";
      if (status === "in_progress" || status === "queued") return "status pending";
      return "status";
    }

    function formatTime(iso) {
      if (!iso) return "";
      const d = new Date(iso);
      return d.toLocaleString();
    }

    async function loadRun() {
      const target = document.querySelector("#run-status");
      const refreshNote = document.querySelector("#auto-refresh-note");

      try {
        const response = await fetch(`/api/runs/${id}`);
        if (!response.ok) {
          target.innerHTML = "<div class='empty'>Unable to load run.</div>";
          return;
        }

        const data = await response.json();
        if (data.error) {
          target.innerHTML = `<div class='empty'>Error: ${data.error}</div>`;
          return;
        }

        const jobs = data.jobs || [];

        const wasSkipped = jobs.length === 1 && jobs[0]?.name?.toLowerCase().includes("preflight") && data.status === "completed";
        const buildJob = jobs.find((j) => j.name && j.name.toLowerCase().includes("build"));
        const buildSkipped = !wasSkipped && data.conclusion === "success" && buildJob?.conclusion === "skipped";

        let statusMessage = data.conclusion || data.status;
        let isSkipped = false;
        if (wasSkipped || buildSkipped) {
          statusMessage = "skipped (cache hit)";
          isSkipped = true;
        }

        const sc = isSkipped ? "status skipped" : statusClass(data.status, data.conclusion);

        if (refreshNote) {
          refreshNote.textContent = isSkipped ? "No build needed." : "Auto-refreshes until done.";
        }

        const skippedBanner = isSkipped
          ? `<div class="info-banner" style="margin-bottom: 1rem; margin-top: 0.5rem;"><strong>Build was skipped</strong> - a release already exists for this ref. <a href="/packages" style="color: var(--accent-2);">Check Packages</a> to download.</div>`
          : "";

        let html = `<div class="run-header">
          <div class="run-header-info">
            <strong class="run-name">${data.name || "Forge build"}</strong>
            <div class="run-links">
              ${data.html_url ? `<a href="${data.html_url}" target="_blank" rel="noreferrer">Open in GitHub</a>` : ""}
              ${data.html_url ? " · " : ""}
              <a href="/packages">Browse Packages</a>
            </div>
          </div>
          <span class="${sc}">${statusMessage}</span>
        </div>
        ${skippedBanner}
        <div class="run-meta">
          <div class="run-meta-item"><span>Created</span><strong>${formatTime(data.created_at) || "unknown"}</strong></div>
          <div class="run-meta-item"><span>Updated</span><strong>${formatTime(data.updated_at) || "unknown"}</strong></div>
          <div class="run-meta-item"><span>Jobs</span><strong>${jobs.length}</strong></div>
        </div>`;

        jobs.forEach(function(job) {
          const jc = statusClass(job.status, job.conclusion);
          const started = job.started_at ? formatTime(job.started_at) : "";
          const completed = job.completed_at ? formatTime(job.completed_at) : "";
          const duration = started && completed ? ` · ${job.started_at && job.completed_at ? Math.round((new Date(job.completed_at) - new Date(job.started_at)) / 1000) + "s" : ""}` : "";

          html += `<div class="job-card">
            <div class="job-card-header">
              <strong>${job.name || "Job"}</strong>
              <span class="${jc}">${job.conclusion || job.status}</span>
            </div>
            ${started ? `<div class="job-card-time">${started}${duration}</div>` : ""}
            <div class="job-steps">`;

          if (job.steps) {
            job.steps.forEach(function(step) {
              const sc = statusClass(step.status, step.conclusion);
              html += `<div class="job-step">
                <span class="job-step-name">${step.name || "Step"}</span>
                <span class="${sc}" style="font-size: 0.78rem;">${step.conclusion || step.status}</span>
              </div>`;
            });
          }

          html += `</div></div>`;
        });

        target.innerHTML = html;

        if (data.status !== "completed") {
          setTimeout(loadRun, 4000);
        }
      } catch (err) {
        target.innerHTML = "<div class='empty'>Error loading run data.</div>";
      }
    }

    loadRun();
  </script>
</AppLayout>

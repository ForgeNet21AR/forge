---
import AppLayout from "../../layouts/AppLayout.astro";

export const prerender = false;
---

<AppLayout title="forge - Build Runs" description="Find and track your build runs.">
  <section class="hero">
    <section class="panel">
      <p class="kicker">Runs</p>
      <h1>Build runs.</h1>
      <p>Look up a run by ID or pick from recent builds.</p>
    </section>
    <aside class="panel">
      <div class="field">
        <label for="run-id">Run ID</label>
        <input id="run-id" placeholder="e.g. 123456789" />
      </div>
      <div class="inline-actions" style="margin-top: 1rem;">
        <button id="open-run" type="button">Open run</button>
      </div>
    </aside>
  </section>

  <section class="panel">
    <div class="toolbar">
      <h2 class="section-title">Recent runs</h2>
      <span class="muted">Saved locally after each build.</span>
    </div>
    <div id="recent-runs" class="empty">No recent runs yet.</div>
  </section>

  <script>
    const recentContainer = document.querySelector("#recent-runs") as HTMLElement;
    const recentRuns: string[] = JSON.parse(localStorage.getItem("forge_recent_runs") || "[]");

    if (recentRuns.length && recentContainer) {
      recentContainer.innerHTML = `<div class="release-grid">${recentRuns
        .map((runId: string) => `
          <a class="release-card" href="/runs/${runId}" style="text-decoration: none;">
            <div class="release-card-top">
              <strong class="release-tool">Run #${runId}</strong>
              <span class="status">open</span>
            </div>
            <div class="release-tag" style="margin-top: 0.25rem;">Click to view details</div>
          </a>
        `)
        .reverse()
        .join("")}</div>`;
    }

    document.querySelector("#open-run")?.addEventListener("click", () => {
      const input = document.querySelector("#run-id") as HTMLInputElement;
      const runId = input.value.trim();
      if (runId) window.location.href = `/runs/${runId}`;
    });

    document.querySelector("#run-id")?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        const input = e.target as HTMLInputElement;
        const runId = input.value.trim();
        if (runId) window.location.href = `/runs/${runId}`;
      }
    });
  </script>
</AppLayout>
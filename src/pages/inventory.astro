---
import AppLayout from "../layouts/AppLayout.astro";
import { catalog, profiles } from "../lib/forge-data";

export const prerender = false;
---

<AppLayout title="forge - Inventory" description="Browse all cataloged tools and their build configuration.">
  <section class="hero">
    <section class="panel">
      <p class="kicker">Inventory</p>
      <h1>Tool catalog.</h1>
      <p>Every tool in the forge catalog, with build settings and status.</p>
    </section>
    <aside class="panel stats">
      <div class="stat">
        <strong>{catalog.length}</strong>
        <span class="muted">tools cataloged</span>
      </div>
    </aside>
  </section>

  <section class="panel">
    <div class="toolbar">
      <div class="toolbar-left" style="display: flex; align-items: center; gap: 0.75rem; flex: 1;">
        <div class="field" style="flex: 1; margin: 0;">
          <input id="inventory-search" placeholder="Search tools by name or repo..." style="min-width: 200px;" autocomplete="off" />
        </div>
        <span id="filtered-count" class="muted" style="flex-shrink: 0;"></span>
      </div>
    </div>
    <div id="inventory-list">
      <div class="release-grid" id="inventory-grid">
        {catalog.map((entry) => {
          const profile = profiles[entry.id];
          return <div class="release-card">
            <div class="release-card-top">
              <strong class="release-tool">{entry.id}</strong>
              <span class="status {entry.enabled ? "success" : "fail"}">{entry.enabled ? "enabled" : "disabled"}</span>
            </div>
            <div class="release-versions" style="gap: 0.3rem;">
              <div class="release-version">
                <div class="release-version-tag" style="font-size: 0.8rem;">repo</div>
                <a class="release-asset-link" href={entry.repo_url} target="_blank" rel="noreferrer">{entry.repo_url}</a>
              </div>
              {(entry.project_path || profile?.project_path) ? <div class="release-version">
                <div class="release-version-tag" style="font-size: 0.8rem;">project</div>
                <span class="release-asset-name">{entry.project_path || profile?.project_path}</span>
              </div> : null}
              <div class="release-version" style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <span><span class="release-version-tag">config</span> {entry.default_configuration || "Release"}</span>
                {entry.default_framework ? <span><span class="release-version-tag">framework</span> {entry.default_framework}</span> : null}
                <span><span class="release-version-tag">strategy</span> {entry.version_strategy}</span>
                {profile ? <span class="status success" style="font-size: 0.78rem;">has profile</span> : null}
              </div>
            </div>
          </div>;
        })}
      </div>
    </div>
  </section>

  <script>
    const grid = document.getElementById("inventory-grid") as HTMLElement;
    const searchInput = document.getElementById("inventory-search") as HTMLInputElement;
    const filteredCount = document.getElementById("filtered-count") as HTMLElement;
    const cards = Array.from(grid.querySelectorAll(".release-card")) as HTMLElement[];

    searchInput?.addEventListener("input", () => {
      const q = searchInput.value.toLowerCase();
      let shown = 0;
      cards.forEach((card) => {
        const text = (card.textContent || "").toLowerCase();
        const match = !q || text.includes(q);
        card.style.display = match ? "" : "none";
        if (match) shown++;
      });
      filteredCount.textContent = shown < cards.length ? `${shown} shown` : "";
    });
  </script>
</AppLayout>